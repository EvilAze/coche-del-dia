# Plantilla de las credenciales de firma del release.
#
# Cópiala a `android/keystore.properties` y rellena los valores. El fichero real
# está en .gitignore (junto a *.keystore y *.jks) y NO puede subirse al repo:
# sin la clave de subida no se pueden publicar actualizaciones de la app en
# Play, y no hay forma de recuperarla si se pierde o se filtra.
#
# Si este fichero no existe, el build sigue funcionando: solo el `bundleRelease`
# sale sin firmar (ver el bloque signingConfigs de android/app/build.gradle).
#
# Generar el keystore una única vez:
#   keytool -genkey -v -keystore cochedeldia-release.keystore \
#     -alias cochedeldia -keyalg RSA -keysize 2048 -validity 10000
#
# Guárdalo FUERA del repo y haz copia de seguridad en sitio seguro.

# Ruta al keystore. Se resuelve desde android/app/, así que lo más claro es
# ponerla ABSOLUTA y con el fichero fuera del repo. En Windows usa barras
# normales o dobles invertidas (C:/claves/... o C:\\claves\\...).
storeFile=C:/claves/cochedeldia-release.keystore
storePassword=CAMBIAME
keyAlias=cochedeldia
keyPassword=CAMBIAME
