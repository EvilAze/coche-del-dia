{
  "appId": "com.cochedeldia",
  "appName": "Coche del Día",
  "webDir": "build",
  "android": {
    "backgroundColor": "#f4f3ef"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": false,
      "backgroundColor": "#f4f3ef",
      "showSpinner": false
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_cdd",
      "iconColor": "#E0574A"
    },
    "SystemBars": {
      "style": "DEFAULT",
      "insetsHandling": "disable"
    },
    "SocialLogin": {
      "providers": {
        "google": true,
        "facebook": false,
        "apple": false,
        "twitter": false
      }
    }
  }
}
