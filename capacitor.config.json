{
  "appId": "com.cochedeldia",
  "appName": "Coche del Día",
  "webDir": "build",
  "android": {
    "backgroundColor": "#f3eee1"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": false,
      "backgroundColor": "#f3eee1",
      "showSpinner": false
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_cdd",
      "iconColor": "#E0574A"
    },
    "StatusBar": {
      "style": "LIGHT"
    },
    "SocialLogin": {
      "providers": {
        "google": true,
        "facebook": false,
        "apple": false,
        "twitter": false
      }
    }
  }
}
