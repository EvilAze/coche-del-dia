# .env.example
# Plantilla de variables de entorno. Copia este archivo a `.env` (o
# `.env.local`) y rellena los valores. Las variables con prefijo VITE_
# llegan al bundle del navegador; las demás solo viven server-side
# (Vercel functions o scripts de Node).
#
# NUNCA commitees .env / .env.local con valores reales. Solo este archivo
# (.env.example) debe ir al repo.

# ─── Supabase ──────────────────────────────────────────────────────────────
# Proyecto Supabase: URL y claves. La anon key se embebe en el cliente
# (es seguro porque RLS protege las tablas — ver scripts/test-rls.mjs).
# La service role key SOLO va en .env / .env.local server-side: bypass de
# RLS, debe quedar siempre en el servidor.
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ─── Tokens firmados (anti-cheat) ──────────────────────────────────────────
# Secreto HMAC compartido para firmar/verificar pseudo-ids de repesca,
# tokens de reveal de imagen y cookies anónimas. CAMBIAR ESTE VALOR
# INVALIDA todas las sesiones anónimas y repescas activas — es esperado
# tras una rotación.
#
# Generar con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REPESCA_TOKEN_SECRET=

# ─── Sentry (observability) ────────────────────────────────────────────────
# DSN del proyecto Sentry para el frontend (cliente browser). Sin esto,
# Sentry no se inicializa y los errores siguen yendo solo a console.
# Crear proyecto en https://sentry.io → Settings → Client Keys (DSN).
#
# Recomendado: dos proyectos Sentry separados, "cochedeldia-frontend" y
# "cochedeldia-backend", para triage más rápido. Si no quieres separar,
# pon el mismo DSN en ambas variables.
VITE_SENTRY_DSN=
SENTRY_DSN=

# ─── DeepL (traducción de descripciones desde admin) ───────────────────────
# Opcional. Solo necesaria si vas a usar /api/admin/translate para
# rellenar description_en automáticamente. Sin esto, la traducción
# manual sigue funcionando desde el admin.
DEEPL_API_KEY=

# ─── Vercel (deploy) ───────────────────────────────────────────────────────
# Estas las inyecta Vercel automáticamente en runtime — no las pongas
# tú a mano salvo que pruebes algo muy específico en local:
#   VERCEL_ENV               'production' | 'preview' | 'development'
#   VERCEL_GIT_COMMIT_SHA    hash del commit desplegado (Sentry usa
#                            esto como tag de release)
#   VERCEL_OIDC_TOKEN        token OIDC para integraciones

# ─── Entrada por correo (código de 6 cifras) ──────────────────────────────
# Segunda puerta del login, ADEMÁS de Google. Hoy va en `false` por decisión de
# producto: la entrada es de un solo toque. El flujo está entero y probado; con
# `true` reaparece en web y en la app, sin tocar código. Antes de encenderlo,
# repasa docs/correo-de-entrada.md (son DOS plantillas de Supabase, no una).
VITE_EMAIL_LOGIN=false

# ─── Google Login nativo (Capacitor / Android) ────────────────────────────
# Login Google NATIVO en la app Android (Capacitor). Es el "Web client ID" del
# OAuth de Google (el mismo que usa Supabase para el login web). No es secreto.
# Sin él, el login en la app no funciona (el juego sigue anónimo); web no lo usa.
VITE_GOOGLE_WEB_CLIENT_ID=
