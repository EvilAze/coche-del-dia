{
  "framework": "vite",
  "buildCommand": "vite build",
  "devCommand": "vite --port $PORT",
  "outputDirectory": "build",

  "rewrites": [
    {
      "source": "/((?!api/|src/|assets/|@|node_modules/|.*\\.).*)",
      "destination": "/index.html"
    }
  ],

  "crons": [
    {
      "path": "/api/cron/warm-daily",
      "schedule": "5 23 * * *"
    }
  ]
}
