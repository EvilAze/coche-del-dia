<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Android App Links: los enlaces a cochedeldia.com abren la app en
                 vez del navegador. Sin esto, el resultado que un jugador
                 comparte por WhatsApp llevaba a la web AUNQUE el amigo tuviera
                 la app instalada, que es un agujero en el bucle de crecimiento
                 del juego.

                 `autoVerify="true"` hace que Android compruebe al instalar que
                 https://cochedeldia.com/.well-known/assetlinks.json contiene la
                 huella con la que está firmada la app. Si casa, los enlaces
                 abren la app en silencio, sin el diálogo de "¿con qué quieres
                 abrir esto?".

                 SOLO se declara el apex, a propósito y con cuidado: desde
                 Android 12 la verificación es TODO O NADA entre los hosts del
                 manifest. Añadir www. o carguessr.org y que uno solo de ellos
                 no sirva su assetlinks.json tumbaría la verificación de TODOS,
                 y el fallo se ve únicamente en un móvil real ya instalado. El
                 apex está confirmado sirviendo sin redirección a www (ver la
                 comprobación con curl en docs/android-build-release.md).

                 No lleva pathPattern: la app es la MISMA SPA que la web, así
                 que puede atender cualquier ruta. El enrutado del enlace
                 entrante lo hace el listener appUrlOpen de src/index.jsx. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="cochedeldia.com" />
            </intent-filter>
        </activity>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- VIBRATE: sin este permiso `navigator.vibrate()` es un no-op SILENCIOSO
         dentro de un WebView. El navegador Chrome tiene el permiso declarado en
         su propio manifest, pero una app que embebe un WebView tiene que
         pedirlo ella: por eso todo src/lib/haptics.js (el vocabulario háptico
         de la app: selection, impactMedium, success, error…) funcionaba en la
         web y no hacía absolutamente nada en la app, sin error ni aviso.
         Es un permiso "normal": no genera diálogo ni aparece en Play como
         permiso sensible. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />
</manifest>
